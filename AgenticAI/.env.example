# Template only — DO NOT put real secrets here (this file is committed to git).
# Copy to .env (kept in this RAG/ directory) and fill in the real values there.
# Loaded via python-dotenv.

# Groq API key — reasoning model (llama-3.1-8b-instant).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Pinecone API key — vector database AND hosted embeddings (llama-text-embed-v2).
# Get one at https://app.pinecone.io
PINECONE_API_KEY=
# Optional: index name (defaults to "rag-examples").
PINECONE_INDEX=rag-examples
